CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y
# A saved album arrives with its whole track list, and covers are 300-pixel
# JPEGs, so Bop downloads far more than playback state alone. The 5760-byte
# default TCP window lets the server send four packets per round trip; 16
# packets keep a download moving. WiFi and lwIP buffers may then live in PSRAM,
# so the larger window does not take the internal RAM that TLS needs. The WiFi
# block-ack window stays at its default: raising it to 16 cut the lowest free
# internal RAM from 37 KB to 14 KB.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_LWIP_TCP_WND_DEFAULT=23360
CONFIG_LWIP_TCP_RECVMBOX_SIZE=32
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# LVGL renders every pixel in software, so the optimization level sets the
# frame rate. Assertions stay enabled.
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# The CPU caches stay at their defaults. They take their space from the
# internal RAM that WiFi and TLS need: a 64 KB data cache stopped WiFi from
# starting, and a 32 KB instruction cache left too little for TLS.
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# LVGL reads touch input and redraws on this period. 16 ms halves the delay
# between a touch and its response compared with the 33 ms default.
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_QRCODE=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
