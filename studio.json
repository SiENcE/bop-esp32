{
  "write": ["game", "art", "assets", "docs/plan"],
  "palette": ["art/mockups/mock_c_iso.px.js"],
  "layers": {
    "room": "game/rooms/{id}.geo.js",
    "texts": "game/strings/{lang}.texts.js",
    "edits": "game/edits.js",
    "sounds": "game/sounds.edit.js",
    "art": "art/import",
    "artAtlas": "assets/imported.js",
    "audio": "assets/audio.js",
    "voices": "assets/voices.{lang}.js",
    "graph": "build/graph"
  },
  "tasks": {
    "validate": ["node", "lib/cutaway/tools/validate.mjs", "index.html"],
    "solve: prolog": ["node", "tools/solve-act.mjs", "prolog", "--full", "--set", "off_roof"],
    "solve: kapitel1 main": ["node", "tools/solve-act.mjs", "kapitel1", "--full", "--set", "off_roof,off_zeitung,off_imai,off_traeger,off_varga,off_tide,off_motte,off_vesper"],
    "graph: prolog": ["sh", "tools/graph.sh", "prolog"],
    "graph: kapitel1 main": ["sh", "tools/graph.sh", "main"],
    "art: everything": ["sh", "tools/build_art.sh"],
    "art: test street": ["sh", "tools/build_art.sh", "test"],
    "art: room": ["sh", "tools/build_art.sh", "room", "{room}"],
    "room: new": ["node", "tools/new-room.mjs", "{room}", "{u}", "{v}"],
    "plan: pictures": ["node", "tools/stadtplan.mjs"],
    "plan: ways": ["node", "tools/stadtplan-links.mjs"]
  },
  "editor": ["game/editor/iso.js", "game/editor/plan.js"]
}
